# Copy to .env and fill in. .env is git-ignored.
# Any OpenAI-compatible chat completions API works (OpenAI, OpenRouter, Ollama, vLLM, LM Studio...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional
# PORT=3000
# How to ask for JSON: json_schema (default), json_object, or none for servers that support neither.
# LLM_RESPONSE_FORMAT=json_schema
# LLM_TIMEOUT_MS=120000
